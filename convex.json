{
  "$schema": "./node_modules/convex/schemas/convex.schema.json",
  "authKit": {
    "dev": {
      "configure": {
        "redirectUris": ["http://localhost:3000/callback", "https://tracky-oos-staging.masushi.workers.dev/callback"],
        "appHomepageUrl": "https://tracky-oos-staging.masushi.workers.dev",
        "corsOrigins": ["http://localhost:3000", "https://tracky-oos-staging.masushi.workers.dev"]
      },
      "localEnvVars": {
        "WORKOS_CLIENT_ID": "${authEnv.WORKOS_CLIENT_ID}",
        "WORKOS_API_KEY": "${authEnv.WORKOS_API_KEY}",
        "WORKOS_REDIRECT_URI": "http://localhost:3000/callback"
      }
    },
    "prod": {
      "environmentType": "production",
      "configure": {
        "redirectUris": ["https://trytracky.app/callback"],
        "appHomepageUrl": "https://trytracky.app",
        "corsOrigins": ["https://trytracky.app"]
      }
    }
  }
}
