#!/bin/sh
# Blocks commits that stage local env files, key material, or PEM private keys.
# Installed via `npm run prepare` (git config core.hooksPath githooks).

staged_files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged_files" ] && exit 0

blocked=""
for file in $staged_files; do
  case "$file" in
    *.env.local.example | .env.local.example | *.env.example | .env.example) ;;
    .env | .env.* | */.env | */.env.* | *.pem | *.key | *.p12 | *.pfx)
      blocked="$blocked  $file\n"
      ;;
  esac
done

if [ -n "$blocked" ]; then
  printf 'pre-commit: refusing to commit secret-bearing files:\n%b' "$blocked" >&2
  printf 'Store secrets with `npx convex env set` instead. Bypass only if you are sure: git commit --no-verify\n' >&2
  exit 1
fi

SECRET_PATTERN='-----BEGIN( [A-Z]+)? PRIVATE KEY-----|sk-(live|test)-[A-Za-z0-9]{10,}|sk_(live|test)_[A-Za-z0-9]{16,}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|ghu_[A-Za-z0-9]{20,}|ghs_[A-Za-z0-9]{20,}|ghr_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|re_[A-Za-z0-9]{20,}|whsec_[A-Za-z0-9_-]{16,}|[0-9]{8,10}:[A-Za-z0-9_-]{35,}|AKIA[0-9A-Z]{16}|IT[0-9]{2}[A-Z][0-9]{22}'

# Scan staged content for secrets. Placeholder example files (*.example) carry
# fake values by design and are excluded here; they are still covered by review.
content_files=""
for file in $staged_files; do
  case "$file" in
    *.example) ;;
    *) content_files="$content_files $file" ;;
  esac
done

if [ -n "$content_files" ]; then
  # shellcheck disable=SC2086
  if git diff --cached -U0 -- $content_files | grep -E "^\\+.*($SECRET_PATTERN)" >/dev/null; then
    printf 'pre-commit: staged changes look like a secret or bank identifier.\n' >&2
    printf 'Store secrets with `npx convex env set` instead. Bypass only if you are sure: git commit --no-verify\n' >&2
    exit 1
  fi
fi

exit 0
