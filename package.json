    "@content-collections/vite": "^0.3.1",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@mdx-js/rollup": "^3.1.1",
    "@posthog/rollup-plugin": "^1.6.2",
