{
  "name": "tracky",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/masushidotdev/tracky#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masushidotdev/tracky.git"
  },
  "bugs": {
    "url": "https://github.com/masushidotdev/tracky/issues"
  },
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "build": "node scripts/generate-sitemap.mjs && node scripts/og-images.mjs && vite build",
    "og": "node scripts/og-images.mjs",
    "og:force": "node scripts/og-images.mjs --force",
    "diagnostics:enable-banking": "node scripts/enable-banking-dump.mjs",
    "start": "vite start",
    "deploy": "CLOUDFLARE_ENV=staging convex deploy --cmd 'npm run build' && CLOUDFLARE_ENV=staging wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV= convex deploy --cmd 'npm run build' && CLOUDFLARE_ENV= wrangler deploy",
    "cf-typegen": "wrangler types",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath githooks",
    "lint": "tsc && tsc -p convex && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "preinstall": "node scripts/check-node-version.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "prebuild": "node scripts/check-node-version.mjs",
    "predev": "node scripts/check-node-version.mjs",
    "predeploy": "node scripts/check-node-version.mjs",
    "predeploy:prod": "node scripts/check-node-version.mjs"
  },
  "dependencies": {
    "@ai-sdk/otel": "^1.0.150",
