# WorkOS AuthKit Configuration
WORKOS_CLIENT_ID=client_your_client_id_here
WORKOS_API_KEY=sk_test_your_api_key_here
WORKOS_WEBHOOK_SECRET=whsec_your_webhook_secret_here
WORKOS_COOKIE_PASSWORD=your_secure_password_here_must_be_at_least_32_characters_long
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Convex Configuration
VITE_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Enable Banking Convex env vars
# For production, set these with `npx convex env set`, not in a local env file.
# Keep the private key out of files whenever possible; rotate it immediately if exposed.
ENABLE_BANKING_APP_ID=00000000-0000-4000-8000-000000000000
ENABLE_BANKING_API_BASE=https://api.enablebanking.com
ENABLE_BANKING_REDIRECT_URL=https://<your-deployment>.convex.site/enablebanking/callback
# Must be https outside local development. Plain http is accepted only for localhost.
ENABLE_BANKING_RETURN_URL=http://localhost:3000/app/settings/bank-connections
# Must be the PEM private key whose public certificate is registered on the
# Enable Banking app above. A key from another app returns `401 Wrong signature`.
ENABLE_BANKING_PRIVATE_KEY=base64_or_escaped_pem_private_key

# Analyst frontend build-time flag: absent or different from 'true' = disabled.
VITE_ANALYST_ENABLED=true

# PostHog product analytics (EU, opt-in banner, client-only).
# Kill-switch: 'false' disables all capture. Key/host empty = no-op.
# The project is single for staging+prod; VITE_POSTHOG_ENV separates traffic.
# No PostHog secrets on Convex in this setup (managed proxy, no server capture).
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=<ph_project_token>
VITE_POSTHOG_API_HOST=<ph_client_api_host>
VITE_POSTHOG_ENV=development
VITE_POSTHOG_REPLAY_SAMPLE=1
# PostHog source-map upload (build-time only; keep the personal API key secret).
POSTHOG_API_KEY=<ph_personal_api_key>
POSTHOG_PROJECT_ID=<ph_project_id>
POSTHOG_HOST=<ph_ui_host>

# Analyst AI keys live in the Convex environment, not in .env.local.
# Set AI_GATEWAY_API_KEY, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, and
# LANGFUSE_BASE_URL with `npx convex env set`.

# Analyst email delivery keys live in the Convex environment, never in Vite or
# browser-visible variables. Set them with `npx convex env set`.
RESEND_API_KEY=re_your_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here
RESEND_FROM_EMAIL=Tracky <reports@example.com>

# Analyst Telegram keys live only in the Convex environment. Do not prefix
# them with VITE_ or place real values in this file.
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_header_secret
TELEGRAM_WEBHOOK_URL=https://your-deployment.convex.site/telegram-webhook
