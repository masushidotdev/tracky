# Tracky self-hosting environment template.
# Copy to `.env` before running `docker compose up -d`:
#   cp .env.selfhost.example .env
# Never commit `.env` or real secrets.

# ------------------------------------------------------------------------------
# Required: Convex self-hosted backend
# ------------------------------------------------------------------------------
# Deployment label used inside Convex admin keys (no spaces).
INSTANCE_NAME=tracky
# 64-character hex secret. Generate with: openssl rand -hex 32
# Changing this invalidates existing admin keys.
INSTANCE_SECRET=replace_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# Required: WorkOS AuthKit (external SaaS — free developer tier available)
# ------------------------------------------------------------------------------
# Create an application in https://dashboard.workos.com, add the redirect URI
# below under Redirects, and paste your Client ID and API Key here.
WORKOS_CLIENT_ID=client_replace_with_your_workos_client_id
WORKOS_API_KEY=sk_replace_with_your_workos_api_key
# Required by @convex-dev/workos-authkit when pushing Convex functions.
# Behind a public HTTPS reverse proxy, create a WorkOS webhook pointing to
# https://<your-convex-site>/workos/webhook and paste its signing secret here.
# For local-only HTTP setups without incoming webhooks, generate a placeholder:
#   echo "whsec_$(openssl rand -hex 16)"
WORKOS_WEBHOOK_SECRET=whsec_replace_with_workos_webhook_secret
# Session cookie encryption secret (minimum 32 characters).
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=replace_with_at_least_32_random_characters_here
# Must match a Redirect URI configured in your WorkOS dashboard.
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Optional WorkOS settings
# WORKOS_COOKIE_NAME=wos-session
# WORKOS_COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Build-time URLs and feature flags (rebuild `app` after changing these)
# ------------------------------------------------------------------------------
# Browser- and SSR-reachable URL of the Convex backend API.
# For local Docker use http://127.0.0.1:3210 (default).
# Behind a reverse proxy with TLS, set to e.g. https://convex.example.com and rebuild.
VITE_CONVEX_URL=http://127.0.0.1:3210
# Public hostname (without scheme) used as APP_PUBLIC_URL in the Worker env.
APP_PUBLIC_URL=localhost:3000
# Enable the AI Analyst UI (default false for self-hosting).
VITE_ANALYST_ENABLED=false

# ------------------------------------------------------------------------------
# Convex backend public origins and host ports
# ------------------------------------------------------------------------------
# Must match the externally reachable URLs of Convex API (3210) and HTTP actions (3211).
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210

# Host ports exposed by docker-compose.yml
APP_PORT=3000
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791

# Keep true on plain HTTP localhost; set false when terminating TLS in front of Convex.
DO_NOT_REQUIRE_SSL=true
# Redact backend function logs sent to browser clients.
REDACT_LOGS_TO_CLIENT=true

# ------------------------------------------------------------------------------
# Optional: External database / S3 storage for Convex backend
# (Unset = SQLite + local file storage inside the `convex-data` named volume)
# ------------------------------------------------------------------------------
# POSTGRES_URL=
# MYSQL_URL=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_S3_FORCE_PATH_STYLE=
# S3_ENDPOINT_URL=
# S3_STORAGE_EXPORTS_BUCKET=
# S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=
# S3_STORAGE_MODULES_BUCKET=
# S3_STORAGE_FILES_BUCKET=
# S3_STORAGE_SEARCH_BUCKET=

# ------------------------------------------------------------------------------
# Optional: Enable Banking (synced to Convex backend if non-empty)
# ------------------------------------------------------------------------------
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_API_BASE=https://api.enablebanking.com
# ENABLE_BANKING_PRIVATE_KEY=
# ENABLE_BANKING_REDIRECT_URL=https://convex-site.example.com/enablebanking/callback
# ENABLE_BANKING_RETURN_URL=https://tracky.example.com/app/settings/bank-connections

# ------------------------------------------------------------------------------
# Optional: AI Analyst, email reports, and Telegram (synced to Convex if non-empty)
# ------------------------------------------------------------------------------
# AI_GATEWAY_API_KEY=
# OPENROUTER_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Tracky <reports@example.com>
# RESEND_WEBHOOK_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=https://convex-site.example.com/telegram-webhook
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
