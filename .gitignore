# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/
/dist-ssr/

# misc
.DS_Store
secrets/
*.p12
*.pfx
*.pem
*.key
*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
# Server-side secrets for the local workerd runtime (mirrors Worker secrets).
.dev.vars

# vercel
.vercel

# wrangler local state
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts
/.content-collections

# Agent worktrees created by Claude Code live inside the repo.
/.claude/worktrees/

# Local provider diagnostics contain raw financial data.
/diagnostics/enable-banking/
/diagnostics/plaid/
/diagnostics/

# Local agent/harness state (never part of the public snapshot).
.cursor/hooks/state/
.claude/settings.json
.claude/skills/
.codex/
convex/_generated/ai/
